# 依存関係
/node_modules
/.pnp
.pnp.*

# Next.js
/.next/
/out/
next-env.d.ts

# ビルド成果物
/build
*.tsbuildinfo

# テスト
/coverage

# 環境変数（値を含むものはコミットしない。雛形の .env.example だけ追跡する）
.env*
!.env.example

# 鍵・証明書
*.pem

# ログ
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# Vercel
.vercel

# Claude Code のローカル設定（許可の付与など、端末ごとに変わるもの）
.claude/settings.local.json

# クラウド側へ渡すための一時アーカイブ（検証のたびに作り直す）
/.claude-tmp/

# Supabase CLI が書くリンク情報（端末ごとに変わる。project_id は config.toml が持つ）
/supabase/.temp/linked-project.json

# OS
.DS_Store

# Playwright（AC-28a / AC-28b のためだけ。CLAUDE.md §2.7）
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# pnpm が入れ替え中に置く空ファイル。削除が止められていると残る
/_tmp_*

# 実データの明細（本物の取引が入っている。絶対に追跡しない）
/.local-samples/
