# このファイルは雛形。値を書き込まず、.env.local にコピーして使う。
# .env.local は .gitignore で除外してある。
#
# Supabase を実際に使い始めるのは PoC開発計画 フェーズ3・タスク#12
# （認証・データ同期・RLS）から。それまでは未設定でも起動する。

# Supabase プロジェクトの URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase の anon キー（公開前提。RLS で保護する）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role キーはこのアプリに置かない。
# クライアントに配られると RLS を素通りして全ユーザーのデータが読める。
# 要件定義書 5.3 / CLAUDE.md §2.5 を参照。
