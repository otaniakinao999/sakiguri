# このファイルは雛形。値を書き込まず、.env.local にコピーして使う。
# .env.local は .gitignore で除外してある。

# Supabase プロジェクトの URL
NEXT_PUBLIC_SUPABASE_URL=

# publishable キー（sb_publishable_...）
# クライアントにバンドルされる前提の公開キー。守るのは RLS。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# secret キー（sb_secret_...）とデータベースのパスワードは、このアプリに置かない。
# クライアントに配られると RLS を素通りして全ユーザーのデータが読める。
# 要件定義書 5.3 / CLAUDE.md §2.5 を参照。
