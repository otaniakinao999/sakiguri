{
  "name": "sakiguri",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "check:node-import": "node --experimental-transform-types --no-warnings scripts/check-node-import.ts",
    "pretest": "pnpm check:node-import",
    "test": "vitest run",
    "bench": "vitest run --config supabase/loadtest/bench.config.mts",
    "loadtest:account": "node --experimental-transform-types --no-warnings --env-file=.env.local scripts/loadtest/ensure-account.ts",
    "loadtest:seed": "node --experimental-transform-types --no-warnings --env-file=.env.local scripts/loadtest/seed.ts",
    "loadtest:teardown": "node --experimental-transform-types --no-warnings --env-file=.env.local scripts/loadtest/teardown.ts",
    "loadtest:ac34": "node --experimental-transform-types --no-warnings --env-file=.env.local scripts/loadtest/ac34.ts",
    "e2e": "node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "db:migrate": "npx --yes supabase@latest db push",
    "db:diff": "npx --yes supabase@latest db diff"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
